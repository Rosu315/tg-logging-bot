# Token issued by @BotFather. Business Mode must be enabled for this bot
# (@BotFather -> /mybots -> your bot -> Bot Settings -> Business Mode).
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Reverse-proxy base URL in front of api.telegram.org (e.g. a Cloudflare
# Worker from ../tg-bypass-tools/telegram-api-worker.js), used when
# api.telegram.org is not reachable directly. Leave empty to talk to
# Telegram directly.
API_BASE_URL=

# Startup seed for the connection allowlist (comma/space separated, without
# @). Only used to populate an empty allowlist on first run; after that it
# lives in the database and is managed via /users, /allow, /deny.
ALLOWED_USERNAMES=your_username

# The only Telegram @username allowed to manage the allowlist from chat
# (/users, /allow, /deny).
ADMIN_USERNAME=your_username

# Where the SQLite database lives.
DB_PATH=data/vestige.db

# Where cached media files are stored (used only when CACHE_MEDIA=true).
MEDIA_DIR=data/media

# Download media to disk as soon as it arrives. Slower and disk-hungry, but it
# survives the case when Telegram invalidates the file_id of a deleted message.
CACHE_MEDIA=false

# Skip caching files bigger than this (megabytes). Bot API download limit is 20 MB.
MAX_CACHE_FILE_MB=20

# How long snapshots are kept before the janitor removes them. 0 disables cleanup.
RETENTION_DAYS=14

# How often the janitor runs, in minutes.
CLEANUP_INTERVAL_MINUTES=60

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- web backup viewer (/backup) ---------------------------------------

# Bind address/port for the backup-viewer web server. Keep the host on
# loopback — a tunnel (e.g. cloudflared) is what's meant to expose it.
WEB_HOST=127.0.0.1
WEB_PORT=8088

# Public HTTPS origin the /backup link is built against, e.g. the hostname
# a cloudflared tunnel maps onto http://WEB_HOST:WEB_PORT. /backup refuses
# to work without this set.
BACKUP_PUBLIC_URL=https://backup.example.com

# How long a /backup link stays valid after it's issued.
BACKUP_LINK_TTL_MINUTES=30
